<Window x:Class="Chess_Sosnina.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Chess_Sosnina"
        mc:Ignorable="d"
        Title="Шахмаы" Height="450" Width="800" MinHeight="450" MinWidth="800">
    <Grid>
        <Grid x:Name="gameBoard" Width="400" Height="400">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Background="White" Width="50" Height="50" Grid.Column="0" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="2" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="4" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="6" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="1" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="3" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="5" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="7" MouseDown="SelectTile"/>

            <Grid Background="White" Grid.Row="1" Width="50" Height="50" Grid.Column="1" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="1" Width="50" Height="50" Grid.Column="3" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="1" Width="50" Height="50" Grid.Column="5" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="1" Width="50" Height="50" Grid.Column="7" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="1" Width="50" Height="50" Grid.Column="0" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="1" Width="50" Height="50" Grid.Column="2" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="1" Width="50" Height="50" Grid.Column="4" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="1" Width="50" Height="50" Grid.Column="6" MouseDown="SelectTile"/>

            <Grid Background="White" Grid.Row="2" Width="50" Height="50" Grid.Column="0" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="2" Width="50" Height="50" Grid.Column="2" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="2" Width="50" Height="50" Grid.Column="4" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="2" Width="50" Height="50" Grid.Column="6" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="2" Width="50" Height="50" Grid.Column="1" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="2" Width="50" Height="50" Grid.Column="3" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="2" Width="50" Height="50" Grid.Column="5" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="2" Width="50" Height="50" Grid.Column="7" MouseDown="SelectTile"/>

            <Grid Background="White" Grid.Row="3" Width="50" Height="50" Grid.Column="1" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="3" Width="50" Height="50" Grid.Column="3" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="3" Width="50" Height="50" Grid.Column="5" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="3" Width="50" Height="50" Grid.Column="7" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="3" Width="50" Height="50" Grid.Column="0" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="3" Width="50" Height="50" Grid.Column="2" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="3" Width="50" Height="50" Grid.Column="4" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="3" Width="50" Height="50" Grid.Column="6" MouseDown="SelectTile"/>

            <Grid Background="White" Grid.Row="4" Width="50" Height="50" Grid.Column="0" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="4" Width="50" Height="50" Grid.Column="2" MouseDown="SelectTile"/>
