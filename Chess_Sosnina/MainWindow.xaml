            <Grid Background="#FF9A6400" Grid.Row="4" Width="50" Height="50" Grid.Column="5" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="4" Width="50" Height="50" Grid.Column="7" MouseDown="SelectTile"/>

            <Grid Background="White" Grid.Row="5" Width="50" Height="50" Grid.Column="1" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="5" Width="50" Height="50" Grid.Column="3" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="5" Width="50" Height="50" Grid.Column="5" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="5" Width="50" Height="50" Grid.Column="7" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="5" Width="50" Height="50" Grid.Column="0" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="5" Width="50" Height="50" Grid.Column="2" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="5" Width="50" Height="50" Grid.Column="4" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="5" Width="50" Height="50" Grid.Column="6" MouseDown="SelectTile"/>

            <Grid Background="White" Grid.Row="6" Width="50" Height="50" Grid.Column="0" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="6" Width="50" Height="50" Grid.Column="2" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="6" Width="50" Height="50" Grid.Column="4" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="6" Width="50" Height="50" Grid.Column="6" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="6" Width="50" Height="50" Grid.Column="1" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="6" Width="50" Height="50" Grid.Column="3" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="6" Width="50" Height="50" Grid.Column="5" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Grid.Row="6" Width="50" Height="50" Grid.Column="7" MouseDown="SelectTile"/>

            <Grid Background="White" Grid.Row="7" Width="50" Height="50" Grid.Column="1" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="7" Width="50" Height="50" Grid.Column="3" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="7" Width="50" Height="50" Grid.Column="5" MouseDown="SelectTile"/>
            <Grid Background="White" Grid.Row="7" Width="50" Height="50" Grid.Column="7" MouseDown="SelectTile"/>
